# 운영 비밀값: 예시 파일만 추적한다.
.env
.env.*
!.env.example
config/.env
config/.env.*
!config/.env.example

# 누적 원천 데이터·학습 산출물·이전 구현
/data/
/artifacts/
/archive/
/verification_logs/

# 개발 도구 상태와 파이썬 캐시
/\.ua/
__pycache__/
**/__pycache__/
*.py[cod]

# 운영체제·노트북 임시 파일
.DS_Store
**/.DS_Store
.ipynb_checkpoints/

# 로컬 가상환경과 테스트·도구 캐시
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 운영 요약만 추적하고 나머지 docs 마크다운은 무시한다.
/docs/*.md
/docs/**/*.md
!/docs/pipeline_summary.md
